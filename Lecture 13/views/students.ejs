<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Profiles</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Poppins:wght@300;400;600&display=swap');

        body {
            margin: 0; padding: 3rem; min-height: 100vh;
            font-family: 'Poppins', sans-serif; background: #050505;
            background-image: radial-gradient(circle at top right, #1a1a2e, #050505), radial-gradient(circle at bottom left, #16213e, #050505);
            background-attachment: fixed; color: #eaeaea;
        }

        .header-title {
            text-align: center; font-family: 'Playfair Display', serif; font-size: 3.5rem;
            color: #d4af37; margin-bottom: 4rem; text-transform: uppercase;
            letter-spacing: 5px; text-shadow: 0 5px 15px rgba(212, 175, 55, 0.2);
        }

        .grid-container {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 2.5rem; max-width: 1400px; margin: 0 auto;
        }

        .student-card {
            background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.05);
            border-top: 1px solid rgba(212, 175, 55, 0.3); backdrop-filter: blur(10px);
            border-radius: 16px; padding: 2rem; transition: all 0.4s ease;
            position: relative; overflow: hidden; display: flex; flex-direction: column;
        }

        .student-card::before {
            content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%;
            background: linear-gradient(to bottom, #d4af37, transparent);
        }

        .student-card:hover {
            transform: translateY(-10px); background: rgba(255, 255, 255, 0.06);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8), 0 0 20px rgba(212, 175, 55, 0.1);
        }

        .card-field { margin-bottom: 1rem; }

        .field-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 2px; color: #888; margin-bottom: 0.2rem; display: block; }
        .field-value { font-size: 1.2rem; font-weight: 400; margin: 0; color: #fff; }

        .name-highlight { font-family: 'Playfair Display', serif; font-size: 1.8rem; color: #d4af37; margin-bottom: 1.5rem; font-style: italic; }
        
        .id-badge {
            position: absolute; top: 1rem; right: 1rem; font-size: 0.7rem;
            background: rgba(212, 175, 55, 0.1); color: #d4af37; padding: 4px 10px;
            border-radius: 20px; letter-spacing: 1px;
        }

        .card-actions { margin-top: auto; display: flex; gap: 10px; }

        .edit-btn, .delete-btn {
            padding: 8px 16px; text-decoration: none; border-radius: 30px;
            font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; transition: all 0.3s ease;
        }

        .edit-btn { background: rgba(50, 150, 255, 0.05); color: #4da3ff; border: 1px solid rgba(50, 150, 255, 0.2); }
        .edit-btn:hover { background: rgba(50, 150, 255, 0.15); border-color: rgba(50, 150, 255, 0.4); box-shadow: 0 5px 15px rgba(50, 150, 255, 0.1); color: #82c0ff; }

        .delete-btn { background: rgba(255, 50, 50, 0.05); color: #ff6b6b; border: 1px solid rgba(255, 50, 50, 0.2); }
        .delete-btn:hover { background: rgba(255, 50, 50, 0.15); border-color: rgba(255, 50, 50, 0.4); box-shadow: 0 5px 15px rgba(255, 50, 50, 0.1); color: #ff8787; }
        
        .home-btn {
            display: block; width: 200px; margin: 0 auto 3rem auto; text-align: center;
            padding: 15px; border-radius: 50px; background: rgba(255, 255, 255, 0.1);
            color: #fff; text-decoration: none; font-weight: bold; border: 1px solid rgba(255,255,255,0.2);
            transition: all 0.3s ease;
        }
        .home-btn:hover { background: rgba(255, 255, 255, 0.2); }
    </style>
</head>
<body>
    
    <h1 class="header-title">Data Archives</h1>
    <a href="/" class="home-btn">Return to Home</a>
    
    <div class="grid-container">
        <% allstudent.forEach((element)=>{ %>
            <div class="student-card">
                <div class="id-badge">ID: <%= element._id %></div>
                
                <h1 class="field-value name-highlight"><%= element.name %></h1>
                
                <div class="card-field">
                    <span class="field-label">Age</span>
                    <h1 class="field-value"><%= element.age %></h1>
                </div>

                <div class="card-field" style="margin-top: 1.5rem; margin-bottom: 2rem; opacity: 0.3;">
                    <span class="field-label">Version</span>
                    <h1 class="field-value" style="font-size: 0.8rem;">v<%= element.__v %></h1>
                </div>

                <div class="card-actions">
                    <a href="/edit/<%= element._id %>" class="edit-btn">Edit</a>
                    <a href="/delete/<%= element._id %>" class="delete-btn">Delete</a>
                </div>
            </div>
        <% }) %>
    </div>

</body>
</html>