<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Student</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@300;400;500&display=swap');

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #141e30, #243b55);
            color: #fff;
        }

        .form-wrapper {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-top: 1px solid rgba(255, 255, 255, 0.2);
            border-left: 1px solid rgba(255, 255, 255, 0.2);
            padding: 3rem 4rem;
            border-radius: 20px;
            box-shadow: 20px 20px 50px rgba(0, 0, 0, 0.5);
            width: 100%;
            max-width: 400px;
            position: relative;
            overflow: hidden;
        }

        body::before, body::after {
            content: ''; position: absolute; border-radius: 50%; filter: blur(80px); z-index: -1;
        }
        body::before { top: 10%; left: 20%; width: 300px; height: 300px; background: rgba(212, 175, 55, 0.2); }
        body::after { bottom: 10%; right: 20%; width: 400px; height: 400px; background: rgba(0, 255, 255, 0.1); }

        h2 {
            font-family: 'Playfair Display', serif;
            text-align: center;
            color: #d4af37;
            font-size: 2.5rem;
            margin-top: 0;
            margin-bottom: 2rem;
            letter-spacing: 2px;
        }

        form { display: flex; flex-direction: column; gap: 1.5rem; }

        input {
            width: 100%; padding: 12px 20px;
            background: rgba(255, 255, 255, 0.05); border: none;
            border-bottom: 2px solid rgba(255, 255, 255, 0.2);
            color: #fff; font-size: 1rem; font-family: 'Poppins', sans-serif;
            border-radius: 8px 8px 0 0; transition: all 0.3s ease; box-sizing: border-box;
        }

        input:focus {
            outline: none; background: rgba(255, 255, 255, 0.1);
            border-bottom-color: #d4af37; box-shadow: 0 10px 20px -10px rgba(212, 175, 55, 0.5);
        }

        input::placeholder { color: rgba(255, 255, 255, 0.5); }

        button {
            margin-top: 1rem; padding: 15px; border: none; border-radius: 50px;
            background: linear-gradient(45deg, #d4af37, #ffdf73); color: #1a1a1a;
            font-size: 1.1rem; font-weight: 700; cursor: pointer;
            box-shadow: 0 10px 20px rgba(212, 175, 55, 0.3); transition: all 0.3s ease;
            text-transform: uppercase; letter-spacing: 2px;
        }

        button:hover { transform: translateY(-3px); box-shadow: 0 15px 25px rgba(212, 175, 55, 0.5); }
    </style>
</head>
<body>
    <div class="form-wrapper">
        <h2>Enroll</h2>
        <form action="/createdata" method="POST">
            <input type="text" name="name" placeholder="Enter Name" required>
            <input type="number" name="age" placeholder="Enter Age" required>
            <button type="submit">Add Student</button>
        </form>
    </div>
</body>
</html>