        <p>Killed 2 people with a pencil.</p>
        <% } else { %>
        <p>Just got married</p>
    <% } %>
    <!-- Priniting one to 10 -->
    <% for(let i=0;i < 11;i++){ %>
        <%= Dipesh.Name %>
        <%= i %>
    <% } %>
</body>
</html>